# Database
DATABASE_URL=postgresql+asyncpg://factory:factory@localhost:5432/factory
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development

# LLM providers (add keys for the providers you want to use)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Local / Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.2

# Security (generate a strong random key for production)
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=
